# =============================================================================
# Photo Gallery UI — Environment Variables
# =============================================================================
# Copy to .env:  cp .env.example .env
# SvelteKit reads PUBLIC_* at build time. Dev proxy uses IMMICH_SERVER_URL.
# =============================================================================

# --- Backend (required for dev proxy) ----------------------------------------
# URL Immich Server — dùng cho Vite dev proxy (REST + WebSocket)
# Production static build: frontend gọi cùng origin hoặc reverse proxy
IMMICH_SERVER_URL=http://localhost:2283

# Alias tương thích spec gốc (map sang IMMICH_SERVER_URL nếu set)
VITE_IMMICH_API_URL=http://localhost:2283

# Port Vite dev server (mặc định 5283 — tránh trùng 5002/5173)
VITE_DEV_PORT=5283
VITE_DEV_HOST=127.0.0.1

# --- Public — injected at build time (SvelteKit PUBLIC_*) -------------------
# Production Vercel: để TRỐNG (Edge Function api/[...path].ts proxy /api → tunnel)
# Dev local: để trống → Vite proxy localhost:2283
PUBLIC_IMMICH_SERVER_URL=

# WebSocket: Vercel không proxy WS — set URL tunnel Immich trên production.
# Dev local: để trống → cùng origin, Vite proxy WebSocket.
PUBLIC_IMMICH_WS_URL=

# Tên ứng dụng hiển thị trên tab, loading screen, dashboard
PUBLIC_APP_NAME=Photo Gallery

# Tên công ty / tổ chức (dashboard, footer)
PUBLIC_COMPANY_NAME=

# Theme mặc định UI: light | dark | system
PUBLIC_THEME=system

# Theme fallback khi system không xác định: light | dark
PUBLIC_DEFAULT_THEME=dark

# Ngôn ngữ mặc định (ISO 639-1, ví dụ: en, vi)
PUBLIC_DEFAULT_LANGUAGE=vi

# Bật analytics (Google Analytics, Plausible, etc.) — tích hợp tương lai
PUBLIC_ENABLE_ANALYTICS=false

# Hiển thị trang / route admin Immich
PUBLIC_ENABLE_ADMIN=true

# Bật tính năng thử nghiệm upstream
PUBLIC_ENABLE_EXPERIMENTAL=false
PUBLIC_SESSION_ONLY_AUTH=false

# Chế độ dev UI — bỏ auth/server, chọn Admin/User tại /auth/login (CHỈ local, không bật production)
PUBLIC_UI_DEV_MODE=false

# --- Feature flags — ẩn hoàn toàn trang khi false -------------------------
PUBLIC_ENABLE_MEMORIES=true
PUBLIC_ENABLE_PARTNER=true
PUBLIC_ENABLE_SHARING=true
PUBLIC_ENABLE_MAP=true
PUBLIC_ENABLE_PEOPLE=true
PUBLIC_ENABLE_SEARCH=true
PUBLIC_ENABLE_EXPLORE=true
PUBLIC_ENABLE_TRASH=true
PUBLIC_ENABLE_UTILITIES=true
PUBLIC_ENABLE_WORKFLOWS=true
PUBLIC_ENABLE_SHARED_LINKS=true
PUBLIC_ENABLE_FOLDERS=true
PUBLIC_ENABLE_TAGS=true
PUBLIC_ENABLE_ARCHIVE=true
PUBLIC_ENABLE_DASHBOARD=true

# --- Login notify (Resend) — production Vercel only ---------------------------
# Client: bật gọi /api/notify-login sau login
PUBLIC_ENABLE_LOGIN_NOTIFY=false

# Server (Vercel — KHÔNG commit key thật vào git):
# LOGIN_NOTIFY_ENABLED=true
# RESEND_API_KEY=re_xxxxxxxx
# ADMIN_NOTIFY_EMAIL=admin@example.com
# LOGIN_NOTIFY_FROM=Photo Gallery <noreply@yourdomain.com>
# LOGIN_NOTIFY_SKIP_ADMIN=true

# --- Immich upstream (optional) ---------------------------------------------
PUBLIC_IMMICH_BUY_HOST=https://buy.immich.app
PUBLIC_IMMICH_PAY_HOST=https://pay.futo.org

# Build label (optional)
IMMICH_BUILD=local
