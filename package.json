{
  "name": "photo-gallery-ui",
  "version": "0.1.0",
  "description": "Custom Immich Web frontend — branded UI layer over upstream Immich",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "prepare:custom": "bash scripts/prepare-custom.sh",
    "predev": "pnpm prepare:custom",
    "prebuild": "pnpm prepare:custom",
    "dev": "bash scripts/dev.sh",
    "predev:local": "pnpm prepare:custom",
    "dev:local": "bash scripts/dev-local.sh",
    "dev:full": "bash scripts/dev-full.sh",
    "build": "pnpm --filter immich-web exec vite build",
    "vite": "bash scripts/vite.sh",
    "preview": "pnpm --filter immich-web preview",
    "check": "pnpm --filter immich-web check:code",
    "docker:up": "bash scripts/docker-up.sh",
    "docker:down": "bash scripts/docker-down.sh",
    "sync:upstream": "bash scripts/sync-upstream.sh",
    "branch": "bash scripts/create-branch.sh",
    "release:notes": "node scripts/release-feature-updates.mjs --dry-run",
    "release:feature-updates": "node scripts/release-feature-updates.mjs",
    "test:release": "node --test scripts/lib/feature-updates-release.test.mjs",
    "check:range": "bash scripts/check-video-range.sh",
    "postinstall": "pnpm --filter @immich/sdk build"
  }
}
