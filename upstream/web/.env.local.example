# Copy → .env.local rồi chạy: pnpm dev:local
# File này KHÔNG được dùng bởi pnpm dev (chỉ dev:local)

# UI dev — không cần server Immich, mock data + chọn Admin/User
PUBLIC_UI_DEV_MODE=true

# Tùy chọn override thêm (uncomment nếu cần):
# IMMICH_SERVER_URL=http://localhost:2283
# PUBLIC_ENABLE_DASHBOARD=true
